{
  "name": "obsidian-custom-file-extensions-plugin",
  "version": "1.3.0",
  "type": "module",
  "description": "Associate views and syntax-highlighted code blocks with custom file extensions via settings.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:electron --format=cjs --target=es2020 --outfile=main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "file-extensions",
    "code-view",
    "syntax-highlighting"
  ],
  "author": "Meep.Tech",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14"
  }
}
