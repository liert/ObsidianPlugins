{
  "name": "obsidian-custom-file-extensions-plugin",
  "version": "1.3.0",
  "type": "module",
  "description": "Associate views and syntax-highlighted code blocks with custom file extensions via settings.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --external:obsidian --external:electron --format=cjs --target=es2020 --outfile=main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "file-extensions",
    "code-view",
    "syntax-highlighting"
  ],
  "author": "Meep.Tech",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.3"
  }
}
