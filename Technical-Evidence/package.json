{
  "name": "technical-evidence",
  "version": "0.1.0",
  "description": "On-demand technical evidence and call chains for Obsidian.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "package": "npm run build && node scripts/package.mjs",
    "deploy": "npm run package && node scripts/deploy.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "jsdom": "^26.1.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
